{
  "name": "arc-task-ledger-release",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "arc:build": "tsc -b apps/arc-task-ledger-api && npm run build -w @zerotrace/arc-task-ledger-web",
    "arc:migrate": "tsx apps/arc-task-ledger-api/src/migrate.ts",
    "arc:worker": "tsx apps/arc-task-ledger-api/src/worker.ts",
    "arc:test:unit": "vitest run tests/arc-task-ledger/unit",
    "arc:test:integration": "vitest run tests/arc-task-ledger/integration",
    "arc:test:e2e": "playwright test --config tests/arc-task-ledger/playwright.config.ts",
    "arc:test:live": "tsx scripts/arc-task-ledger-live.ts",
    "arc:start": "npm run start -w @zerotrace/arc-task-ledger-api",
    "lint": "eslint . --max-warnings=0",
    "license:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'Apache-2.0;Apache-2.0 WITH LLVM-exception;BSD-2-Clause;BSD-3-Clause;CC0-1.0;ISC;MIT;0BSD;BlueOak-1.0.0;Python-2.0'"
  },
  "devDependencies": {
    "@types/node": "24.10.14",
    "typescript": "6.0.3",
    "tsx": "4.23.11",
    "vitest": "4.1.11",
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "@eslint/js": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript-eslint": "8.66.0",
    "prettier": "3.9.6",
    "license-checker-rseidelsohn": "4.4.2"
  }
}
